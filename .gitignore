# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebooks and Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
*.ipynb.bak

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
ActiveState.venv/

# Serialized ML Models (to prevent large binary files in git)
*.pkl
*.joblib
*.h5
*.model

# OS generated files
.DS_Store
Thumbs.db

# VS Code and IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Ignore actual data files in the data directory but track the folder via .gitkeep
data/*
!data/.gitkeep
